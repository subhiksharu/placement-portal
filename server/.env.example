# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/placement_portal
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placement_portal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/placement_portal

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=replace_with_a_long_random_secret_key

# Allowed Client URLs for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Cloudinary Credentials (Required for student resume PDF uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial TPO Account Seed Credentials (used by server/seed/createTPO.js)
TPO_EMAIL=tpo@college.com
TPO_PASSWORD=tpo12345
TPO_NAME=Placement Officer
